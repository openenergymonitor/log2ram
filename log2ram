#!/usr/bin/env sh

. /etc/log2ram.conf

HDD_LOG=/var/log.bak
OLD_LOG=/var/log.old
RAM_LOG=/var/log

LOG_NAME="log2ram.log"
LOG2RAM_LOG="${RAM_LOG}/${LOG_NAME}"
LOG_OUTPUT="tee -a $LOG2RAM_LOG"

isSafe () {
    [ -d $HDD_LOG/ ] || echo "ERROR: $HDD_LOG/ doesn't exist! Can't sync."
    [ -d $HDD_LOG/ ] || exit 1
}

logSize () {
    du -s --block-size=1 $RAM_LOG/ | cut -f1
}

# If the logs on disk would not fit in RAM, free space rather than leave logs
# writing to the SD card. Runs at boot before anything is mounted over /var/log,
# so moving a file to $OLD_LOG is a rename on the same filesystem. Trims to half
# of SIZE, as logs that only just fit would soon fill the RAM disk.
trimLogs () {
    limit=$(numfmt --from=iec "$SIZE" 2>/dev/null) || return 0
    [ "$(logSize)" -ge "$limit" ] || return 0
    target=$((limit / 2))
    echo "$RAM_LOG is larger than $SIZE, trimming to fit in RAM" | $LOG_OUTPUT

    if [ -d $RAM_LOG/journal ]; then
        echo "Removing $RAM_LOG/journal" | $LOG_OUTPUT
        rm -rf $RAM_LOG/journal
    fi
    [ "$(logSize)" -gt "$target" ] || return 0

    echo "Removing rotated logs from $RAM_LOG" | $LOG_OUTPUT
    find $RAM_LOG/ -xdev -type f \( -name '*.gz' -o -name '*.[0-9]' -o -name '*.old' \) -delete

    # Keep the largest logs in $OLD_LOG, overwriting any kept by an earlier trim.
    # Leave an empty file behind with the same owner and permissions, as a
    # service may not be allowed to create it again.
    mkdir -p $OLD_LOG
    while [ "$(logSize)" -gt "$target" ]; do
        largest=$(find $RAM_LOG/ -xdev -type f -size +0c -printf '%s\t%p\n' | sort -n | tail -n 1 | cut -f2-)
        [ -n "$largest" ] || break
        kept="$OLD_LOG/oversize-$(echo "${largest#"$RAM_LOG"/}" | tr '/' '_')"
        mv -f "$largest" "$kept" || break
        touch "$largest"
        chown --reference="$kept" "$largest"
        chmod --reference="$kept" "$largest"
        echo "Moved $largest to $kept" | $LOG_OUTPUT
    done
}

syncToDisk () {
    isSafe

    if [ "$USE_RSYNC" = true ]; then
        rsync -aXv --inplace --no-whole-file --delete --links $RAM_LOG/ $HDD_LOG/ 2>&1 | $LOG_OUTPUT
        # TODO confirm the best rsync command by running some comparision tests
        # See https://community.openenergymonitor.org/t/emonsd-next-steps-filesystem/10693/54?u=pb66
        #rsync -aXWv --delete --links $RAM_LOG/ $HDD_LOG/ 2>&1 | $LOG_OUTPUT
    else
        cp -rfup $RAM_LOG/ -T $HDD_LOG/ 2>&1 | $LOG_OUTPUT
    fi
}

syncFromDisk () {
    isSafe

    if [ ! -z "$(du -sh -t "$SIZE" $HDD_LOG/ | cut -f1)" ]; then
        echo "ERROR: RAM disk too small. Can't sync."
        umount -l $RAM_LOG/
        umount -l $HDD_LOG/
        if [ "$MAIL" = true ]; then
            echo "LOG2RAM : No place on RAM anymore, fallback on the disk" | mail -s 'Log2Ram Error' root;
        fi
        exit 1
    fi

    if [ "$USE_RSYNC" = true ]; then
        rsync -aXWv --delete --links $HDD_LOG/ $RAM_LOG/ 2>&1 | $LOG_OUTPUT
    else
        cp -rfup $HDD_LOG/ -T $RAM_LOG/ 2>&1 | $LOG_OUTPUT
    fi
}

wait_for () {
    while ! grep -qs "$1" /proc/mounts; do
        sleep 0.1
    done
}

case "$1" in
  start)
      trimLogs
      [ -d $HDD_LOG/ ] || mkdir $HDD_LOG/
      mount --bind $RAM_LOG/ $HDD_LOG/
      mount --make-private $HDD_LOG/
      wait_for $HDD_LOG
      mount -t tmpfs -o nosuid,noexec,nodev,mode=0755,size="$SIZE" log2ram $RAM_LOG/
      wait_for $RAM_LOG
      syncFromDisk
      [ -d $RAM_LOG/rotated_logs ] || ln -s $OLD_LOG $RAM_LOG/rotated_logs
      ;;

  stop)
      syncToDisk
      umount -l $RAM_LOG/
      umount -l $HDD_LOG/
      ;;

  write)
      syncToDisk
      ;;

  *)
      echo "Usage: log2ram {start|stop|write}" >&2
      exit 1
      ;;
esac
